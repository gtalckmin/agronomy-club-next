# Public browser configuration for a Firebase Hosting production build.
# Copy this file to client/.env.production, replace each value, and do not commit it.
NEXT_PUBLIC_BACKEND_URL=https://production-api-host/api
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=agronomy-club.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=agronomy-club
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-web-app-id
